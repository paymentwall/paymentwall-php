{
    "name": "paymentwall/paymentwall-php",
    "description": "Paymentwall PHP Library. Paymentwall is the leading digital payments platform for globally monetizing digital goods and services.",
    "version": "2.2.4",
    "type": "library",
    "homepage": "https://www.paymentwall.com/?source=gh",
    "keywords": [
        "paymentwall",
        "api",
        "payments",
        "carrier billing",
        "credit cards",
        "alternative payments",
        "monetization",
        "recurring billing",
        "payment processing"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Paymentwall Team",
            "email": "devsupport@paymentwall.com"
        }
    ],
    "prefer-stable": true,
    "require": {
        "php": "~8.0",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "behat/behat": "~3.0",
        "friendsofphp/php-cs-fixer": "~3.0",
        "rector/rector": "~2.0",
        "squizlabs/php_codesniffer": "~4.0"
    },
    "scripts": {
        "test": [
            "@composer install",
            "vendor/behat/behat/bin/behat"
        ]
    },
    "autoload": {
        "classmap": ["lib/Paymentwall/"]
    },
    "minimum-stability": "dev"
}
